# 行尾统一（issue #293）：仓库权威形态是 LF。eol=lf 高于
# core.autocrlf——Windows 检出（autocrlf=true 常态）不再产生幻影 M。
* text=auto eol=lf

# 源码显式声明（防未来工具改动 text=auto 语义时漂移）。
*.go   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf

# 二进制（当前仓库无跟踪的二进制产物；占位防将来误判）。
*.png  binary
*.jpg  binary
*.gif  binary
*.webp binary
*.ico  binary
*.exe  binary
*.dll  binary
*.wasm binary
*.zip  binary
*.pdf  binary
